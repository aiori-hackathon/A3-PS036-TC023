@startuml PQC_DNSSEC_MTL_Architecture
skinparam monochrome true
skinparam style strictuml
skinparam shadowing false
skinparam roundcorner 5
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam nodesep 35
skinparam ranksep 35

title **PQC DNSSEC MTL BENCHMARK TESTBED - SYSTEM ARCHITECTURE**

' --------------------------------------------------------------------
' TIER 1: MANAGEMENT, CRYPTO ENGINE & SHARED STORAGE
' --------------------------------------------------------------------
package "1. Management Layer" as T1_Mgmt {
    [Web Workbench UI\n(Port 8080)] as UI
    [CLI Orchestrator\n(tb.sh)] as CLI
    [Tools Container\n(pqcmtl/tools)] as Tools
    
    CLI -down-> Tools
    UI -down-> Tools
}

package "2. Crypto Engine (pqcdns)" as T1_Crypto {
    [Zone Signer\n(signer.py)] as Signer
    [MTL Engine\n(cSHAKE-128)] as MTLEngine
    [liboqs Library\n(ML-DSA-44)] as LibOQS
    [Classical Engine\n(ECDSA P-256)] as ECDSA
    
    Signer -down-> MTLEngine
    Signer -down-> LibOQS
    Signer -down-> ECDSA
}

database "3. Shared Storage Volumes" as T1_Storage {
    folder "/zones\n(Signed Zones & Anchors)" as VolZones
    folder "/config\n(lab-root.hints)" as VolConfig
    folder "/results\n(Metrics, CSVs & Logs)" as VolResults
}

' --------------------------------------------------------------------
' TIER 2: CONTAINER LAB NETWORK (172.30.53.0/24)
' --------------------------------------------------------------------
package "4. Isolated Lab Network Topology (172.30.53.0/24)" as T2_Net {

    package "Client Node (.100)" as BoxClient {
        [dig Stub Resolver] as Dig
        [PQC Validator\n(pqcdns.validator)] as Validator
        [Ladder Cache] as Cache
        
        Dig -down-> Validator
        Validator -right-> Cache
    }

    package "Recursive Resolver (.53)" as BoxRec {
        [PowerDNS Recursor 5.3\n(process-no-validate)] as Recursor
    }

    package "Authoritative Delegation Hierarchy" as BoxAuth {
        [Root Server (.10)\nZone: .] as Root
        [TLD Server (.20)\nZone: test.] as TLD
        [SLD Server (.30)\nZone: aiori3.test.] as SLD
        
        Root -right-> TLD : [NS+DS]
        TLD -right-> SLD : [NS+DS]
    }
}

' Horizontal alignment
T1_Mgmt -[hidden]right-> T1_Crypto
T1_Crypto -[hidden]right-> T1_Storage

BoxClient -[hidden]right-> BoxRec
BoxRec -[hidden]right-> BoxAuth

' Top-to-bottom layout alignment
T1_Mgmt -[hidden]down-> BoxClient
T1_Crypto -[hidden]down-> BoxRec
T1_Storage -[hidden]down-> BoxAuth

' --------------------------------------------------------------------
' CLEAN PIPELINE ARROWS ONLY (NO CLUTTER)
' --------------------------------------------------------------------
Tools -> Signer : (A) batch signing
Signer -> VolZones : (B) save zones

VolZones ..> BoxAuth : (C) mounts zones
VolConfig ..> Recursor : mounts hints
Validator ..> VolResults : (D) logs & metrics

' Clean single arrow between Client, Recursor, and Authoritative
Dig -> Recursor : (1) Query (DO=1) / (4) Answer
Recursor -> Root : (2) Iterative Walk / (3) Referral
Validator -> Recursor : (5) Fetch ladder (TCP)

legend bottom
|= Step |= Interaction Flow Description |
| (A)-(C) | Batch Signing & Mount: Tools run signer via liboqs/MTL; stores signed zones into /zones; mounted into authoritative servers |
| (1)-(4) | DNS Resolution: Client queries Recursor; Recursor iteratively resolves Root -> TLD -> SLD; returns condensed RRSIG |
| (5)-(D) | PQC Validation: Validator requests _mtlladder TXT via TCP on cache-miss, verifies ladder with ML-DSA-44, and writes logs to /results |
endlegend

@enduml
